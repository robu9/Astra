# Copy to .env. Any OpenAI-compatible endpoint works (OpenAI, OpenRouter, TensorMux, Groq, LM Studio, Ollama).
ASTRA_LLM=openai
ASTRA_LLM_BASE_URL=https://api.openai.com/v1
ASTRA_LLM_API_KEY=sk-...
ASTRA_MODEL_FAST=gpt-4o-mini
ASTRA_MODEL_STRONG=gpt-4o

# Offline smoke mode (no key): ASTRA_LLM=mock

# Optional: AO worker defaults for `python -m astra ao-run`
# AO_PROJECT_ID=
# ASTRA_AO_AGENT=claude-code
